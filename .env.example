NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_SITE_URL=http://localhost:3000
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_DB_PASSWORD=
# Direct Postgres connection used by Kysely migrator
DATABASE_URL=postgresql://postgres:<SUPABASE_DB_PASSWORD>@db.<PROJECT_REF>.supabase.co:5432/postgres
# Maximum PostgreSQL clients per running app instance. Keep the total across
# all instances below the Supabase pool allowance.
DATABASE_POOL_MAX=3

# Google Calendar — shared company calendar, OAuth refresh-token auth.
#
# Not a service account: the Cloud organisation enforces
# iam.managed.disableServiceAccountKeyCreation, so no key can be issued.
#
# Set up once:
#   1. Cloud console -> APIs & Services -> Library -> enable "Google Calendar API"
#   2. OAuth consent screen -> user type INTERNAL. External apps left in Testing
#      hand out refresh tokens that expire after 7 days.
#   3. Credentials -> Create credentials -> OAuth client ID -> "Desktop app".
#      Desktop clients accept the http://127.0.0.1 loopback the consent script
#      uses; a "Web application" client rejects it as redirect_uri_mismatch.
#   4. Put the client id/secret below, then: npm run calendar:consent
#      Sign in as the calendar's owner; it prints the refresh token.
#
# GOOGLE_CALENDAR_ID is under the calendar's Settings and sharing ->
# "Integrate calendar". The account granting consent must be able to edit it.
GOOGLE_CALENDAR_ID=
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REFRESH_TOKEN=

# Zoho Books — server-only OAuth refresh-token integration.
# The token needs settings.READ, contacts.READ/CREATE,
# estimates.READ/CREATE/UPDATE, and invoices.READ/CREATE.
ZOHO_OAUTH_CLIENT_ID=
ZOHO_OAUTH_CLIENT_SECRET=
# Prevents legacy Self Client credentials from being used by the CRM OAuth flow.
ZOHO_OAUTH_CLIENT_KIND=server
# Base64-encoded 32-byte key used only to encrypt stored OAuth tokens.
ZOHO_TOKEN_ENCRYPTION_KEY=
# Set per deployment. Both callback URLs must be registered in Zoho:
# http://localhost:3001/api/integrations/zoho/callback
# https://app.drapeworks.sg/api/integrations/zoho/callback
ZOHO_OAUTH_REDIRECT_URI=http://localhost:3001/api/integrations/zoho/callback
# Optional for non-US Zoho data centres.
ZOHO_ACCOUNTS_BASE_URL=https://accounts.zoho.com
# Create an Estimate custom field named "CRM Quote Key" in Zoho Books.
# Premium/Elite/Ultimate plans may make it unique. Other plans use the same
# field with application-side lookup and reconciliation before creation.
# Supply both its API name (for lookup) and numeric field id (payload).
ZOHO_ESTIMATE_CRM_KEY_API_NAME=
ZOHO_ESTIMATE_CRM_KEY_ID=
# Existing "Spreadsheet Template" template id.
ZOHO_ESTIMATE_TEMPLATE_ID=
